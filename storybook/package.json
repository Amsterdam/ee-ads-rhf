{
  "name": "@amsterdam/ee-ads-rhf-storybook",
  "version": "0.0.0",
  "scripts": {
    "start": "storybook dev --config-dir config/ --port 6006",
    "build": "storybook build --output-dir dist/ --config-dir config/ --quiet && touch dist/.nojekyll",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "lint:styles": "stylelint ./**/*.{css,scss}",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@amsterdam/design-system-assets": "^2.3.0",
    "@amsterdam/design-system-css": "^4.1.0",
    "@amsterdam/design-system-react": "^4.1.0",
    "@amsterdam/design-system-react-icons": "^2.0.0",
    "@amsterdam/design-system-tokens": "^4.0.1",
    "@amsterdam/ee-ads-rhf": "*",
    "@hookform/resolvers": "^5.2.2",
    "clsx": "^2.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.77.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "10.4.2",
    "@storybook/addon-docs": "10.4.2",
    "@storybook/addon-themes": "10.4.2",
    "@storybook/addon-vitest": "10.4.2",
    "@storybook/react-vite": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/browser": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint-plugin-storybook": "10.4.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "storybook": "10.4.2",
    "stylelint": "^17.12.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "vite": "^7.3.2",
    "vitest": "^4.1.8"
  }
